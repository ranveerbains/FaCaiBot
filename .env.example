# Mode: "simulation" (no real trades, Telegram reporting) or "live" (real trading)
MODE=simulation

# Polymarket CLOB credentials (L2 auth — required for live mode only)
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# Wallet private key (hex, with or without 0x prefix — required for live mode only)
PRIVATE_KEY=

# Infrastructure (defaults shown)
QUESTDB_URL=127.0.0.1:9009

# Binance SBE market data (required — Ed25519 API key for binary streams)
# Generate key: npm run generate -- -k ed25519  (binance/asymmetric-key-generator)
# Then: Binance > API Management > Create API (Ed25519) > paste public key > Read only
BINANCE_ED25519_API_KEY=
# BINANCE_SBE_WS_URL=wss://stream-sbe.binance.com:9443

# Telegram (required for simulation mode)
# Bot username: @f4c4ibot
# Get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram command control (optional)
# If set, enables bidirectional bot control via Telegram commands (/stop, /set, etc.)
# Get your user ID from @userinfobot on Telegram
# TELEGRAM_ALLOWED_USER_ID=

# Logging level
RUST_LOG=facaibot=info

# Config file path (default: config.toml)
# CONFIG_FILE=config.toml
