# Mode: "simulation" (no real trades, Telegram reporting) or "live" (real trading)
MODE=simulation

# Polymarket CLOB credentials (L2 auth — required for live mode only)
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# Wallet private key (hex, with or without 0x prefix — required for live mode only)
PRIVATE_KEY=

# Infrastructure (defaults shown)
REDIS_URL=redis://127.0.0.1:6379
QUESTDB_URL=127.0.0.1:9009

# Binance WebSocket (default shown)
BINANCE_WS_URL=wss://stream.binance.com:9443

# Telegram (required for simulation mode)
# Bot username: @f4c4ibot
# Get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Strategy Parameters
# Confidence thresholds (0-1 scale) for allocation tiers
HIGH_CONFIDENCE=0.8
MED_CONFIDENCE=0.5

# Allocation percentages by confidence tier (decimal, e.g., 0.30 = 30%)
HIGH_ALLOC_PCT=0.30
MED_ALLOC_PCT=0.20
LOW_ALLOC_PCT=0.10

# Maximum allocation percentage per market (prevents overexposure)
MAX_ALLOC_PCT=0.30

# Adverse movement detection (after Leg 1 fill)
# Grace period: milliseconds before adverse monitoring activates (avoids false triggers)
ADVERSE_GRACE_PERIOD=3000
# Threshold: price reversal percentage (decimal) that triggers emergency FOK hedge
ADVERSE_THRESHOLD=0.003

# Simulation mode: starting virtual USDC balance
FIXED_ALLOC=100

# Logging level
RUST_LOG=facaibot=info

# Optional: Enable Chainlink price feed (via Polymarket RTDS)
RTDS_ENABLED=false
