# Mode: "simulation" (no real trades, Telegram reporting) or "live" (real trading)
MODE=simulation

# Polymarket CLOB credentials (L2 auth — required for live mode only)
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# Wallet private key (hex, with or without 0x prefix — required for live mode only)
PRIVATE_KEY=

# Infrastructure (defaults shown)
REDIS_URL=redis://127.0.0.1:6379
QUESTDB_URL=127.0.0.1:9009

# Binance WebSocket (default shown)
BINANCE_WS_URL=wss://stream.binance.com:9443

# Telegram (required for simulation mode)
# Bot username: @f4c4ibot
# Get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging level
RUST_LOG=facaibot=info

# Config file path (default: config.toml)
# CONFIG_FILE=config.toml
