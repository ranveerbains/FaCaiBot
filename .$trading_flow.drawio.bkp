          <mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- BE breach emergency -->
        <mxCell id="be_emerg" value="&lt;b&gt;BREAK-EVEN BREACH&lt;/b&gt;&lt;br&gt;emergency_submitted = true&lt;br&gt;exit_reason = BreakEvenBreach&lt;br&gt;&lt;br&gt;Post-only at best_ask - tick&lt;br&gt;Gated behind steps ≥ 1 (~3.5s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;" vertex="1" parent="1">
