          <mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Favorable taker (from normal erosion path) -->
        <mxCell id="d_fav" value="&lt;b&gt;Favorable taker?&lt;/b&gt;&lt;br&gt;ask &lt; posted bid" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="1000" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a_fav1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="normal_erosion" target="d_fav" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="fav_exit" value="&lt;b&gt;FAVORABLE TAKER&lt;/b&gt;&lt;br&gt;Take at ask (FOK)&lt;br&gt;exit_reason = FavorableTaker&lt;br&gt;&lt;br&gt;[SIM] fill at ask price&lt;br&gt;[LIVE] post-only first, FOK fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
