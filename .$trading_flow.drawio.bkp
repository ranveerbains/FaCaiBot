        </mxCell>
        <mxCell id="a_fav_yes_l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#2E7D32;" vertex="1" connectable="0" parent="a_fav_yes">
          <mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="emit_erosion" value="&lt;b&gt;Emit Erosion Signal&lt;/b&gt;&lt;br&gt;Cancel-replace at eroded price" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="1005" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="a_fav_no" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4CAF50;" edge="1" source="d_fav" target="emit_erosion" parent="1">
