          <mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Decision 3: Break-even breach? -->
        <mxCell id="d3" value="&lt;b&gt;Break-even breach?&lt;/b&gt;&lt;br&gt;steps ≥ 1 AND&lt;br&gt;ask worsened &gt; 2 ticks AND&lt;br&gt;pair cost ≥ $1.00" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#E65100;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="565" y="470" width="250" height="100" as="geometry"/>
