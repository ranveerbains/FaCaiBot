          <mxGeometry x="60" y="1110" width="1240" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="edge_title" value="&lt;b&gt;Additional Edge Cases&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="560" y="1120" width="200" height="30" as="geometry"/>
        </mxCell>

        <!-- Market Rotation Emergency -->
        <mxCell id="rot_emerg" value="&lt;b&gt;Rotation Emergency&lt;/b&gt;&lt;br&gt;&lt;br&gt;MarketRotation arrives while&lt;br&gt;Leg 1 = Filled, Leg 2 ≠ Filled&lt;br&gt;&lt;br&gt;1. Build FOK with OLD market's&lt;br&gt;   token IDs + books&lt;br&gt;2. Drain buffer → send FOK&lt;br&gt;3. Send MarketRotation → reset&lt;br&gt;&lt;br&gt;exit_reason = MarketExpiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="1170" width="240" height="170" as="geometry"/>
        </mxCell>

        <!-- Leg 1 Staleness Timeout -->
        <mxCell id="leg1_timeout" value="&lt;b&gt;Leg 1 Staleness Timeout&lt;/b&gt;&lt;br&gt;&lt;br&gt;Posted Leg 1 not filled within&lt;br&gt;leg1_timeout_ms (5000ms)&lt;br&gt;&lt;br&gt;→ Cancel order, free slot&lt;br&gt;→ leg1_state = None&lt;br&gt;→ Ready for next spike&lt;br&gt;&lt;br&gt;[SIM] In advance_simulation()&lt;br&gt;[LIVE] CancelLeg1 command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="1170" width="240" height="170" as="geometry"/>
        </mxCell>

        <!-- Cutoff Window -->
        <mxCell id="cutoff" value="&lt;b&gt;Cutoff Window&lt;/b&gt;&lt;br&gt;&lt;br&gt;T-300s before expiry:&lt;br&gt;&lt;br&gt;✗ New Leg 1 entries BLOCKED&lt;br&gt;✓ Existing Leg 2 erosion continues&lt;br&gt;✓ Emergency exits continue&lt;br&gt;✓ Market summary sent&lt;br&gt;&lt;br&gt;Open positions ride until&lt;br&gt;rotation (no forced close)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="1170" width="240" height="170" as="geometry"/>
        </mxCell>

        <!-- User WS Delay -->
        <mxCell id="ws_delay" value="&lt;b&gt;User WS Fill Delay (Live)&lt;/b&gt;&lt;br&gt;&lt;br&gt;CLOB fill → User WS: 200-500ms&lt;br&gt;REST feedback → Engine: 50-100ms&lt;br&gt;&lt;br&gt;Safety: feedback channel drained&lt;br&gt;BEFORE on_event() each loop.&lt;br&gt;Order IDs always set before&lt;br&gt;fill notifications arrive." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="1170" width="240" height="170" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- PAGE 3: State Machines -->
  <diagram id="state-machines" name="State Machines">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title3" value="&lt;b&gt;State Machines &amp; Transitions&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="540" y="20" width="340" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== OrderState ===== -->
        <mxCell id="os_title" value="&lt;b&gt;OrderState&lt;/b&gt; (applies to both Leg 1 and Leg 2)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="340" height="30" as="geometry"/>
        </mxCell>

        <!-- None state -->
        <mxCell id="os_none" value="&lt;b&gt;None&lt;/b&gt;&lt;br&gt;(idle)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#616161;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="130" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- Posted state -->
        <mxCell id="os_posted" value="&lt;b&gt;Posted&lt;/b&gt;&lt;br&gt;order_id, price, size" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Filled state -->
        <mxCell id="os_filled" value="&lt;b&gt;Filled&lt;/b&gt;&lt;br&gt;price, size, timestamp" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="620" y="130" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- None → Posted -->
        <mxCell id="os_a1" value="evaluate() emits signal&lt;br&gt;executor posts order" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="os_none" target="os_posted" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Posted → Filled -->
        <mxCell id="os_a2" value="[LIVE] User WS fill&lt;br&gt;[SIM] advance_simulation()" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="os_posted" target="os_filled" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Posted → None (failure) -->
        <mxCell id="os_a3" value="OrderFailed (CLOB reject)&lt;br&gt;OR Leg 1 timeout (5s)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#F44336;fontColor=#C62828;" edge="1" source="os_posted" target="os_none" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="220"/>
              <mxPoint x="160" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Filled → None (completion) -->
        <mxCell id="os_a4" value="on_trade_complete()&lt;br&gt;OR MarketRotation" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#1976D2;fontColor=#1565C0;" edge="1" source="os_filled" target="os_none" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="240"/>
              <mxPoint x="160" y="240"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== ErosionState ===== -->
        <mxCell id="es_title" value="&lt;b&gt;ErosionState&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="290" width="120" height="30" as="geometry"/>
        </mxCell>

        <!-- None -->
        <mxCell id="es_none" value="&lt;b&gt;None&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#616161;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="340" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- Active -->
        <mxCell id="es_active" value="&lt;b&gt;Active&lt;/b&gt;&lt;br&gt;steps=0..5&lt;br&gt;emergency=false" style="ellipse;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="330" width="160" height="70" as="geometry"/>
        </mxCell>

        <!-- Emergency -->
        <mxCell id="es_emergency" value="&lt;b&gt;Emergency&lt;/b&gt;&lt;br&gt;emergency=true&lt;br&gt;exit_reason set&lt;br&gt;repost_count: 0→3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="330" width="180" height="70" as="geometry"/>
        </mxCell>

        <!-- Complete -->
        <mxCell id="es_complete" value="&lt;b&gt;Complete&lt;/b&gt;&lt;br&gt;erosion = None" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="880" y="340" width="140" height="50" as="geometry"/>
        </mxCell>

        <!-- None → Active -->
        <mxCell id="es_a1" value="init_erosion()&lt;br&gt;(Leg 1 fills)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="es_none" target="es_active" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Active → Active (erosion step) -->
        <mxCell id="es_a2" value="erosion step&lt;br&gt;(steps++)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#1976D2;curved=1;" edge="1" source="es_active" target="es_active" parent="1">
          <mxGeometry x="0.3" y="20" relative="1" as="geometry">
            <mxPoint as="offset"/>
            <Array as="points">
              <mxPoint x="400" y="310"/>
              <mxPoint x="430" y="310"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Active → Emergency -->
        <mxCell id="es_a3" value="Adverse / BE breach /&lt;br&gt;Exhausted" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#C62828;fontColor=#C62828;" edge="1" source="es_active" target="es_emergency" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Emergency → Complete (fill) -->
        <mxCell id="es_a4" value="Leg 2 fill" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#2E7D32;fontColor=#2E7D32;" edge="1" source="es_emergency" target="es_complete" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Active → Complete (normal fill) -->
        <mxCell id="es_a5" value="Leg 2 fill&lt;br&gt;(normal)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#2E7D32;fontColor=#2E7D32;" edge="1" source="es_active" target="es_complete" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="430"/>
              <mxPoint x="950" y="430"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Complete → None -->
        <mxCell id="es_a6" value="on_trade_complete()&lt;br&gt;OR rotation" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#616161;" edge="1" source="es_complete" target="es_none" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="450"/>
              <mxPoint x="150" y="450"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== SimPosition ===== -->
        <mxCell id="sp_title" value="&lt;b&gt;SimPosition Status&lt;/b&gt; (simulation only)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="290" height="30" as="geometry"/>
        </mxCell>

        <!-- None -->
        <mxCell id="sp_none" value="&lt;b&gt;None&lt;/b&gt;&lt;br&gt;(no position)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#616161;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="550" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- Open -->
        <mxCell id="sp_open" value="&lt;b&gt;Open&lt;/b&gt;&lt;br&gt;Leg 1 filled, Leg 2 pending" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="545" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- Hedged -->
        <mxCell id="sp_hedged" value="&lt;b&gt;Hedged&lt;/b&gt;&lt;br&gt;Both legs filled" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="550" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- AwaitingResolution -->
        <mxCell id="sp_await" value="&lt;b&gt;AwaitingResolution&lt;/b&gt;&lt;br&gt;Locked for UMA oracle" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="650" width="180" height="50" as="geometry"/>
        </mxCell>

        <!-- ClosedTrades -->
        <mxCell id="sp_closed" value="&lt;b&gt;[closed_trades]&lt;/b&gt;&lt;br&gt;Final PnL recorded" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="650" width="150" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="sp_a1" value="record_leg1_fill()" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="sp_none" target="sp_open" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sp_a2" value="record_leg2_fill() /&lt;br&gt;record_emergency_*()" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="sp_open" target="sp_hedged" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sp_a3" value="lock_for_resolution()&lt;br&gt;(rotation, no hedge)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#F44336;fontColor=#C62828;" edge="1" source="sp_open" target="sp_await" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sp_a4" value="close_trade()" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="sp_hedged" target="sp_closed" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== Full Trade Lifecycle ===== -->
        <mxCell id="tl_title" value="&lt;b&gt;Full Trade Lifecycle&lt;/b&gt; (numbered steps)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="740" width="290" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="tl1" value="&lt;b&gt;1. SpikeConfirmed&lt;/b&gt;&lt;br&gt;spike_detected = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="790" width="160" height="45" as="geometry"/>
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="tl2" value="&lt;b&gt;2. evaluate()&lt;/b&gt;&lt;br&gt;10 guards → Leg 1 signal&lt;br&gt;leg1_state = Posted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="785" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="tl3" value="&lt;b&gt;3. Leg 1 Fill&lt;/b&gt;&lt;br&gt;leg1_state = Filled&lt;br&gt;init_erosion()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="785" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- Step 4 -->
        <mxCell id="tl4" value="&lt;b&gt;4. evaluate_leg2()&lt;/b&gt;&lt;br&gt;Erosion cascade&lt;br&gt;OR emergency path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="785" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- Step 5 -->
        <mxCell id="tl5" value="&lt;b&gt;5. Leg 2 Fill&lt;/b&gt;&lt;br&gt;leg2_state = Filled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="790" width="160" height="45" as="geometry"/>
        </mxCell>

        <!-- Step 6 -->
        <mxCell id="tl6" value="&lt;b&gt;6. State Reset&lt;/b&gt;&lt;br&gt;→ Ready for next spike" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="790" width="160" height="45" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="tl_a1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="tl1" target="tl2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="tl_a2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="tl2" target="tl3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="tl_a3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="tl3" target="tl4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="tl_a4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="tl4" target="tl5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="tl_a5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="tl5" target="tl6" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Failure paths from lifecycle -->
        <mxCell id="tl_fail1" value="Guard fail&lt;br&gt;(spike cleared)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#F44336;" vertex="1" parent="1">
          <mxGeometry x="305" y="860" width="80" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="tl_fa1" style="strokeColor=#F44336;dashed=1;" edge="1" source="tl2" target="tl_fail1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="tl_fail2" value="Timeout / reject&lt;br&gt;→ None" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#F44336;" vertex="1" parent="1">
          <mxGeometry x="505" y="860" width="100" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="tl_fa2" style="strokeColor=#F44336;dashed=1;" edge="1" source="tl3" target="tl_fail2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Sim vs Live annotations on step 3 -->
        <mxCell id="tl3_sim" value="[SIM] advance_sim()" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=8;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="490" y="770" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="tl3_live" value="[LIVE] User WS fill" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=8;fontColor=#7B1FA2;" vertex="1" parent="1">
          <mxGeometry x="490" y="845" width="110" height="20" as="geometry"/>
        </mxCell>

        <!-- Key timing info -->
        <mxCell id="timing_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1">
          <mxGeometry x="80" y="920" width="500" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="timing_title" value="&lt;b&gt;Key Timing&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="925" width="90" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="timing_content" value="• Spike detection: ~300ms (sustain) after initial displacement&lt;br&gt;• Leg 1 fill (sim): next event loop (~100ms). Live: CLOB RTT (~50-100ms)&lt;br&gt;• Erosion cascade: 5 steps over ~6.8s (3.5s → 1.75s → 0.875s → 0.437s → 0.218s)&lt;br&gt;• Emergency repost: every 500ms, FOK fallback after 3 attempts (1.5s)&lt;br&gt;• Leg 1 staleness timeout: 5000ms&lt;br&gt;• Cutoff window: 300s before market expiry&lt;br&gt;• Pre-warm rotation: 180s before expiry" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="950" width="480" height="100" as="geometry"/>
        </mxCell>

        <!-- Exit reasons summary -->
        <mxCell id="exit_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1">
          <mxGeometry x="620" y="920" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="exit_title" value="&lt;b&gt;Exit Reasons&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="925" width="100" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="exit_content" value="• &lt;b&gt;NormalErosion&lt;/b&gt; — Leg 2 filled during erosion cascade (happy path)&lt;br&gt;• &lt;b&gt;AdverseMovement&lt;/b&gt; — Binance reversal &gt; 0.1%&lt;br&gt;• &lt;b&gt;BreakEvenBreach&lt;/b&gt; — Opposing ask worsened or cascade exhausted&lt;br&gt;• &lt;b&gt;MarketExpiry&lt;/b&gt; — Rotation arrived with open position&lt;br&gt;• &lt;b&gt;FavorableTaker&lt;/b&gt; — Opposing ask dropped below posted bid" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="630" y="950" width="400" height="90" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
