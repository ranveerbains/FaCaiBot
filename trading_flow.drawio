  <diagram id="page1_spike" name="1. Spike Detection → Leg 1 Entry">
    <mxGraphModel dx="3717" dy="1179" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p1_title" value="Page 1: Spike Detection → Leg 1 Entry" style="text;html=1;fontSize=18;fontStyle=1;align=center;" parent="1" vertex="1"><mxGeometry x="450" y="10" width="400" height="30" as="geometry" /></mxCell><mxCell id="p1_spike_title" value="SPIKE DETECTION (spike.rs)" style="text;html=1;fontSize=14;fontStyle=5;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" parent="1" vertex="1"><mxGeometry x="80" y="50" width="300" height="30" as="geometry" /></mxCell><mxCell id="p1_s1" value="Binance SBE @depth20 tick&#10;(every 50ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1"><mxGeometry x="130" y="95" width="200" height="40" as="geometry" /></mxCell><mxCell id="p1_s2" value="Compute mid = (best_bid + best_ask) / 2&#10;Update EMA-ATR (alpha=0.01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1"><mxGeometry x="115" y="155" width="230" height="40" as="geometry" /></mxCell><mxCell id="p1_d1" value="ATR warmed up?&#10;(≥10 ticks)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1"><mxGeometry x="155" y="215" width="150" height="60" as="geometry" /></mxCell><mxCell id="p1_d2" value="|delta| &amp;gt; {2} × ATR?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1"><mxGeometry x="155" y="305" width="150" height="60" as="geometry" /></mxCell><mxCell id="p1_d3" value="magnitude ≥ {0.01}%?&lt;br&gt;(|delta|/mid ≥ 1bp)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1"><mxGeometry x="140" y="395" width="180" height="65" as="geometry" /></mxCell><mxCell id="p1_candidate" value="⚡ Emit SpikeCandidate&#10;(direction, magnitude)&#10;T = 0ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="140" y="495" width="180" height="50" as="geometry" /></mxCell><mxCell id="p1_wait" value="Sustain window&#10;(next 300ms of ticks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1"><mxGeometry x="150" y="575" width="160" height="40" as="geometry" /></mxCell><mxCell id="p1_d4" value="Still displaced&#10;above threshold&#10;at T+300ms?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1"><mxGeometry x="145" y="645" width="170" height="70" as="geometry" /></mxCell><mxCell id="p1_d5" value="Momentum ratio&#10;≥ 0.65?&#10;(current/peak)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1"><mxGeometry x="145" y="750" width="170" height="70" as="geometry" /></mxCell><mxCell id="p1_confirmed" value="✓ Emit SpikeConfirmed&#10;⏱ T + 300ms&#10;→ speculative gate opens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="150" y="855" width="190" height="55" as="geometry" /></mxCell><mxCell id="p1_rej_warmup" value="Skip&#10;(warming up)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;fontSize=10;" parent="1" vertex="1"><mxGeometry x="370" y="225" width="90" height="40" as="geometry" /></mxCell><mxCell id="p1_rej_atr" value="None&#10;(normal tick)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;fontSize=10;" parent="1" vertex="1"><mxGeometry x="370" y="315" width="90" height="40" as="geometry" /></mxCell><mxCell id="p1_rej_mag" value="None&#10;rej_magnitude++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1"><mxGeometry x="370" y="410" width="100" height="40" as="geometry" /></mxCell><mxCell id="p1_failed1" value="SpikeFailed&#10;(displacement faded)&#10;→ CancelLeg1 if Posted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1"><mxGeometry x="370" y="660" width="150" height="50" as="geometry" /></mxCell><mxCell id="p1_failed2" value="SpikeFailed&#10;(momentum faded)&#10;→ CancelLeg1 if Posted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1"><mxGeometry x="370" y="765" width="150" height="50" as="geometry" /></mxCell><mxCell id="p1_e1" parent="1" source="p1_s1" target="p1_s2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e2" parent="1" source="p1_s2" target="p1_d1" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e3" value="YES" style="fontColor=#28a745;fontStyle=1;fontSize=10;" parent="1" source="p1_d1" target="p1_d2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e3n" value="NO" style="fontColor=#b85450;fontStyle=1;fontSize=10;" parent="1" source="p1_d1" target="p1_rej_warmup" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e4" value="YES" style="fontColor=#28a745;fontStyle=1;fontSize=10;" parent="1" source="p1_d2" target="p1_d3" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e4n" value="NO" style="fontColor=#b85450;fontStyle=1;fontSize=10;" parent="1" source="p1_d2" target="p1_rej_atr" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e5" value="YES" style="fontColor=#28a745;fontStyle=1;fontSize=10;" parent="1" source="p1_d3" target="p1_candidate" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e5n" value="NO" style="fontColor=#b85450;fontStyle=1;fontSize=10;" parent="1" source="p1_d3" target="p1_rej_mag" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e6" parent="1" source="p1_candidate" target="p1_wait" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e7" parent="1" source="p1_wait" target="p1_d4" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e8" value="YES" style="fontColor=#28a745;fontStyle=1;fontSize=10;" parent="1" source="p1_d4" target="p1_d5" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e8n" value="NO" style="fontColor=#b85450;fontStyle=1;fontSize=10;" parent="1" source="p1_d4" target="p1_failed1" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e9" value="YES" style="fontColor=#28a745;fontStyle=1;fontSize=10;" parent="1" source="p1_d5" target="p1_confirmed" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e9n" value="NO" style="fontColor=#b85450;fontStyle=1;fontSize=10;" parent="1" source="p1_d5" target="p1_failed2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_entry_title" value="LEG 1 ENTRY (evaluate() in evaluator.rs)" style="text;html=1;fontSize=14;fontStyle=5;align=center;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" parent="1" vertex="1"><mxGeometry x="560" y="50" width="370" height="30" as="geometry" /></mxCell><mxCell id="p1_on_event" value="Engine: on_event(SpikeCandidate)&#10;→ spike_detected = true&#10;→ speculative_awaiting_sustain = true&#10;⏱ ~0μs (instant channel recv)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1"><mxGeometry x="580" y="165" width="280" height="65" as="geometry" /></mxCell><mxCell id="p1_g1" value="Guards 1-3: Data available?&#10;• active_condition_id exists&#10;• Direction book exists (YES/NO)&#10;• binance_price exists" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="585" y="240" width="270" height="80" as="geometry" /></mxCell><mxCell id="p1_g2" value="Guard 4: Book fresh?&lt;br&gt;book_age &amp;lt; {150}ms" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="620" y="280" width="200" height="60" as="geometry" /></mxCell><mxCell id="p1_g3" value="Guard 5: Price not skewed?&#10;YES mid in [0.15, 0.85]" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="610" y="370" width="220" height="60" as="geometry" /></mxCell><mxCell id="p1_g4" value="Guard 6: Spread OK?&#10;(ask - bid) / tick ≤ 2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="620" y="460" width="200" height="60" as="geometry" /></mxCell><mxCell id="p1_g5" value="Guard 7: No active trade?&#10;leg1_state == None" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="620" y="550" width="200" height="60" as="geometry" /></mxCell><mxCell id="p1_g6" value="Guard 8: Not near expiry?&#10;time_remaining &gt; 180s" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="620" y="640" width="200" height="60" as="geometry" /></mxCell><mxCell id="p1_g7" value="Guard 9: Depth OK?&#10;bid_depth ≥ 20% of size" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="620" y="730" width="200" height="60" as="geometry" /></mxCell><mxCell id="p1_rg1" value="NoBook /&#10;NoBinance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" parent="1" vertex="1"><mxGeometry x="910" y="190" width="80" height="35" as="geometry" /></mxCell><mxCell id="p1_rg2" value="StaleBook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" parent="1" vertex="1"><mxGeometry x="910" y="290" width="80" height="25" as="geometry" /></mxCell><mxCell id="p1_rg3" value="PriceSkewed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" parent="1" vertex="1"><mxGeometry x="910" y="385" width="80" height="25" as="geometry" /></mxCell><mxCell id="p1_rg4" value="SpreadWide" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" parent="1" vertex="1"><mxGeometry x="910" y="475" width="80" height="25" as="geometry" /></mxCell><mxCell id="p1_rg5" value="ActiveTrade&#10;(rej_busy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" parent="1" vertex="1"><mxGeometry x="910" y="560" width="80" height="35" as="geometry" /></mxCell><mxCell id="p1_rg6" value="Cutoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" parent="1" vertex="1"><mxGeometry x="910" y="655" width="80" height="25" as="geometry" /></mxCell><mxCell id="p1_rg7" value="LowDepth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" parent="1" vertex="1"><mxGeometry x="910" y="745" width="80" height="25" as="geometry" /></mxCell><mxCell id="p1_pricing" value="Compute bid price:&#10;1. base = best_bid + tick&#10;2. cap at best_ask - tick (post-only)&#10;3. smart outbid walls (&gt;4x avg depth)&#10;4. break-even cap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1"><mxGeometry x="595" y="820" width="250" height="75" as="geometry" /></mxCell><mxCell id="p1_confidence" value="Confidence scoring:&#10;0.4×(spike/ATR) + 0.2×(depth) + 0.2×(time)&#10;≥0.6=HIGH(3%) ≥0.3=MED(2%) &lt;0.3=LOW(1%)&#10;alloc = max(round($10 × tier_pct), $1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1"><mxGeometry x="595" y="915" width="260" height="65" as="geometry" /></mxCell><mxCell id="p1_signal" value="Emit Leg 1 Signal&#10;leg1_state = Posted&#10;⏱ ~10μs total eval&#10;⏱ +50–100ms CLOB round-trip (live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="615" y="1085" width="210" height="75" as="geometry" /></mxCell><mxCell id="p1_ge0" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="p1_on_event" target="p1_g1" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge1" value="✓" style="fontColor=#28a745;fontSize=10;" parent="1" source="p1_g1" target="p1_g2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge1n" value="✗" style="fontColor=#b85450;fontSize=10;" parent="1" source="p1_g1" target="p1_rg1" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge2" value="✓" style="fontColor=#28a745;fontSize=10;" parent="1" source="p1_g2" target="p1_g3" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge2n" value="✗" style="fontColor=#b85450;fontSize=10;" parent="1" source="p1_g2" target="p1_rg2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge3" value="✓" style="fontColor=#28a745;fontSize=10;" parent="1" source="p1_g3" target="p1_g4" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge3n" value="✗" style="fontColor=#b85450;fontSize=10;" parent="1" source="p1_g3" target="p1_rg3" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge4" value="✓" style="fontColor=#28a745;fontSize=10;" parent="1" source="p1_g4" target="p1_g5" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge4n" value="✗" style="fontColor=#b85450;fontSize=10;" parent="1" source="p1_g4" target="p1_rg4" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge5" value="✓" style="fontColor=#28a745;fontSize=10;" parent="1" source="p1_g5" target="p1_g6" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge5n" value="✗" style="fontColor=#b85450;fontSize=10;" parent="1" source="p1_g5" target="p1_rg5" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge6" value="✓" style="fontColor=#28a745;fontSize=10;" parent="1" source="p1_g6" target="p1_g7" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge6n" value="✗" style="fontColor=#b85450;fontSize=10;" parent="1" source="p1_g6" target="p1_rg6" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge7" value="✓" style="fontColor=#28a745;fontSize=10;" parent="1" source="p1_g7" target="p1_pricing" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge7n" value="✗" style="fontColor=#b85450;fontSize=10;" parent="1" source="p1_g7" target="p1_rg7" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge8" parent="1" source="p1_pricing" target="p1_confidence" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge9" parent="1" source="p1_confidence" target="p1_g_hedge" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_cross" value="IngestorEvent channel" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#9673a6;fontSize=10;fontColor=#9673a6;" parent="1" source="p1_candidate" target="p1_on_event" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="520" /><mxPoint x="500" y="120" /></Array></mxGeometry></mxCell><mxCell id="p1_note" value="All rejections clear spike_detected = false.&#10;Each spike gets exactly ONE evaluation attempt.&#10;Rejected spikes cost nothing (no order placed).&#10;Rotation quiet period (30s) blocks all entries." style="text;html=1;fontSize=10;fontStyle=2;fillColor=#f5f5f5;strokeColor=#999;rounded=1;" parent="1" vertex="1"><mxGeometry x="880" y="810" width="260" height="55" as="geometry" /></mxCell><mxCell id="p1_next" value="→ Continue on Page 2:&#10;Leg 1 Fill + Leg 2 Hedge" style="text;html=1;fontSize=12;fontStyle=3;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;" parent="1" vertex="1"><mxGeometry x="600" y="1430" width="240" height="40" as="geometry" /></mxCell><mxCell id="p1_enext" parent="1" source="p1_resolve_yes" target="p1_next" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_g_hedge" value="Guard 10: Hedge feasible?&#10;bid + opp_ask ≤ $1.00" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="620" y="995" width="200" height="60" as="geometry" /></mxCell><mxCell id="p1_rg_hedge" value="HedgeInfeasible" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1"><mxGeometry x="910" y="1010" width="100" height="25" as="geometry" /></mxCell><mxCell id="p1_ge_hedge_pass" value="✓" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;" parent="1" source="p1_g_hedge" target="p1_signal" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_ge_hedge_fail" value="✗" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="p1_g_hedge" target="p1_rg_hedge" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_par_box" value="" style="rounded=1;dashed=1;dashPattern=8 8;strokeColor=#FF6600;strokeWidth=2;fillColor=none;" parent="1" vertex="1"><mxGeometry x="40" y="550" width="510" height="390" as="geometry" /></mxCell><mxCell id="p1_par_label" value="⚡ PARALLEL EXECUTION (T=0ms → T+300ms)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#FF6600;align=center;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="-282.5" y="995" width="975" height="22" as="geometry" /></mxCell><mxCell id="p1_time_left" value="⏱ Left path: ~300ms wall clock&#10;(sustain confirmation window)" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#999999;align=left;" parent="1" vertex="1"><mxGeometry x="60" y="625" width="250" height="30" as="geometry" /></mxCell><mxCell id="p1_time_right" value="⏱ Right path: ~10μs total&#10;(all 10 guards + pricing + signal)" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#999999;align=left;" parent="1" vertex="1"><mxGeometry x="582" y="155" width="250" height="30" as="geometry" /></mxCell><mxCell id="p1_par_note" value="Order is posted in ~10μs — already in CLOB queue&#10;~300ms before sustain check completes.&#10;Live mode: +50–100ms for CLOB round-trip." style="text;html=1;fontSize=10;fontStyle=2;fontColor=#FF6600;align=center;fillColor=#FFF8E7;strokeColor=#FFD699;rounded=1;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="55" y="945" width="380" height="50" as="geometry" /></mxCell><mxCell id="p1_res_title" value="SPECULATIVE RESOLUTION" style="text;html=1;fontSize=14;fontStyle=5;align=center;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" parent="1" vertex="1"><mxGeometry x="470" y="1170" width="250" height="28" as="geometry" /></mxCell><mxCell id="p1_resolve" value="At T+300ms:&#10;Spike sustained?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="635" y="1220" width="180" height="80" as="geometry" /></mxCell><mxCell id="p1_resolve_yes" value="SpikeConfirmed&#10;→ awaiting_sustain = false&#10;→ sim fills unblocked&#10;→ Leg 2 begins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="620" y="1340" width="190" height="65" as="geometry" /></mxCell><mxCell id="p1_resolve_no" value="SpikeFailed&#10;If still Posted → CancelLeg1&#10;If already Filled → Leg 2 proceeds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1"><mxGeometry x="340" y="1340" width="230" height="55" as="geometry" /></mxCell><mxCell id="p1_e_sig_res" value="" style="endArrow=classic;html=1;" parent="1" source="p1_signal" target="p1_resolve" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e_res_yes" value="YES" style="endArrow=classic;html=1;fontStyle=1;fontColor=#82b366;" parent="1" source="p1_resolve" target="p1_resolve_yes" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e_res_no" value="NO" style="endArrow=classic;html=1;fontStyle=1;fontColor=#b85450;" parent="1" source="p1_resolve" target="p1_resolve_no" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_quiet_guard" value="Engine: in_quiet_period?&#10;(30s after rotation)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="575" y="85" width="180" height="55" as="geometry" /></mxCell><mxCell id="p1_quiet_reject" value="Spike dropped&#10;(quiet period)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" parent="1" vertex="1"><mxGeometry x="810" y="90" width="100" height="35" as="geometry" /></mxCell><mxCell id="p1_eq_pass" value="NO" style="fontColor=#28a745;fontStyle=1;fontSize=10;" parent="1" source="p1_quiet_guard" edge="1" target="p1_on_event" /><mxCell id="p1_eq_reject" value="YES" style="fontColor=#b85450;fontStyle=1;fontSize=10;" parent="1" source="p1_quiet_guard" edge="1" target="p1_quiet_reject" /></root></mxGraphModel>
  </diagram>
  <diagram id="page2_leg2" name="2. Leg 1 Fill → Leg 2 → Complete">
    <mxGraphModel dx="1347" dy="748" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p2_title" value="Page 2: Leg 1 Fill → Leg 2 Hedge → Trade Complete" style="text;html=1;fontSize=18;fontStyle=1;align=center;" parent="1" vertex="1"><mxGeometry x="350" y="10" width="500" height="30" as="geometry" /></mxCell><mxCell id="p2_posted" value="Leg 1 Posted (speculative)&#10;Order on CLOB / sim state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="350" y="55" width="250" height="40" as="geometry" /></mxCell><mxCell id="p2_sustain" value="T+300ms: Sustain check" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1"><mxGeometry x="370" y="120" width="210" height="55" as="geometry" /></mxCell><mxCell id="p2_confirmed" value="SpikeConfirmed&#10;speculative_awaiting_sustain = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;" parent="1" vertex="1"><mxGeometry x="170" y="210" width="240" height="40" as="geometry" /></mxCell><mxCell id="p2_failed" value="SpikeFailed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="570" y="210" width="150" height="30" as="geometry" /></mxCell><mxCell id="p2_failed_d" value="leg1_state?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="580" y="265" width="120" height="50" as="geometry" /></mxCell><mxCell id="p2_cancel" value="Posted → CancelLeg1&#10;Reset all state&#10;(zero cost)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1"><mxGeometry x="530" y="340" width="140" height="45" as="geometry" /></mxCell><mxCell id="p2_noop" value="Filled → No-op&#10;Leg 2 proceeds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=10;" parent="1" vertex="1"><mxGeometry x="710" y="340" width="120" height="40" as="geometry" /></mxCell><mxCell id="p2_sim_title" value="SIM MODE" style="text;html=1;fontSize=13;fontStyle=5;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" parent="1" vertex="1"><mxGeometry x="60" y="275" width="100" height="25" as="geometry" /></mxCell><mxCell id="p2_sim_gate" value="advance_simulation()&#10;Gate: awaiting_sustain?&#10;→ YES: skip (block fill)&#10;→ NO: check fill conditions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="310" width="200" height="60" as="geometry" /></mxCell><mxCell id="p2_sim_fill" value="Leg 1 Fill Check:&#10;• bid &lt; best_ask (post-only valid)&#10;• near-ask depth &gt; 0 (within 2 ticks)&#10;→ Filled, init_erosion()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="395" width="210" height="65" as="geometry" /></mxCell><mxCell id="p2_live_title" value="LIVE MODE" style="text;html=1;fontSize=13;fontStyle=5;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;" parent="1" vertex="1"><mxGeometry x="285" y="275" width="100" height="25" as="geometry" /></mxCell><mxCell id="p2_live_post" value="Executor: post-only GTC to CLOB&#10;→ OrderPosted feedback (order_id)&#10;→ Engine stores order_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" parent="1" vertex="1"><mxGeometry x="265" y="310" width="210" height="55" as="geometry" /></mxCell><mxCell id="p2_live_fill" value="User WS: TradeStatusUpdate&#10;→ Match order_id&#10;→ Filled, init_erosion()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" parent="1" vertex="1"><mxGeometry x="275" y="395" width="190" height="50" as="geometry" /></mxCell><mxCell id="p2_erosion_init" value="Leg 1 Filled → Init Erosion&#10;Capture: fill_price, fill_time,&#10;binance_at_fill, initial_target&#10;Direction: leg1_direction (not spike.direction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="150" y="495" width="250" height="50" as="geometry" /></mxCell><mxCell id="p2_erosion_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;dashed=1;" parent="1" vertex="1"><mxGeometry x="30" y="570" width="540" height="290" as="geometry" /></mxCell><mxCell id="p2_erosion_title" value="LEG 2 EROSION CASCADE (5 steps, triangle weights [5,4,3,2,1])" style="text;html=1;fontSize=12;fontStyle=5;align=center;" parent="1" vertex="1"><mxGeometry x="50" y="575" width="500" height="20" as="geometry" /></mxCell><mxCell id="p2_step_table" value="Step  Weight  %Margin  Interval   Cumulative&#10;  0     5/15    33.3%    3000ms     3.0s&#10;  1     4/15    26.7%    1500ms     4.5s&#10;  2     3/15    20.0%     750ms     5.25s&#10;  3     2/15    13.3%     375ms     5.625s&#10;  4     1/15     6.7%     200ms     5.825s&#10;─────────────────────────────────────────&#10;Total: 100% eroded → break-even in ~5.8s" style="text;html=1;fontSize=10;fontFamily=Courier New;fillColor=#fff;strokeColor=#999;rounded=1;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="45" y="600" width="320" height="130" as="geometry" /></mxCell><mxCell id="p2_erosion_flow" value="Each step:&#10;1. Check emergency triggers (→ Page 3)&#10;2. Check interval gate (time since last)&#10;3. Compute target_price:&#10;   1.0 - current_profit - leg1_price&#10;4. Constraints: don't cross ask,&#10;   break-even floor, smart outbid&#10;5. Skip guard: if posted ≤ target,&#10;   keep existing order (no repost)&#10;6. Emit erosion signal → cancel+repost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="380" y="600" width="180" height="155" as="geometry" /></mxCell><mxCell id="p2_exhausted" value="After step 4: erosion exhausted&#10;→ auto-triggers BreakEvenBreach&#10;emergency (see Page 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1"><mxGeometry x="55" y="745" width="220" height="45" as="geometry" /></mxCell><mxCell id="p2_skip_note" value="Skip guard: if the current resting Leg 2 order&#10;is already at-or-better than the new target price,&#10;skip the cancel-and-repost. Prevents erosion from&#10;overwriting a better price (e.g. from favorable exit)." style="text;html=1;fontSize=9;fontStyle=2;fillColor=#f5f5f5;strokeColor=#ccc;rounded=1;" parent="1" vertex="1"><mxGeometry x="290" y="762" width="265" height="55" as="geometry" /></mxCell><mxCell id="p2_leg2_fill_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;dashed=1;" parent="1" vertex="1"><mxGeometry x="30" y="880" width="540" height="140" as="geometry" /></mxCell><mxCell id="p2_leg2_title2" value="LEG 2 FILL" style="text;html=1;fontSize=12;fontStyle=5;" parent="1" vertex="1"><mxGeometry x="50" y="885" width="100" height="20" as="geometry" /></mxCell><mxCell id="p2_sim_l2" value="SIM: advance_simulation()&#10;• ask ≤ posted → fill as maker ($0 fee)&#10;• ask &lt; posted → favorable taker (fee)&#10;• else → no fill, wait" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1"><mxGeometry x="45" y="910" width="230" height="60" as="geometry" /></mxCell><mxCell id="p2_live_l2" value="LIVE: User WS fill notification&#10;• TradeStatusUpdate → Confirmed&#10;• Match by leg2 order_id&#10;• leg2_state = Filled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" parent="1" vertex="1"><mxGeometry x="300" y="910" width="230" height="60" as="geometry" /></mxCell><mxCell id="p2_complete" value="TRADE COMPLETE&#10;Both legs Filled → on_trade_complete()&#10;Reset: leg1_state, leg2_state, erosion = None&#10;cumulative_used persists (reset on rotation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="140" y="1050" width="310" height="60" as="geometry" /></mxCell><mxCell id="p2_stale_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;dashed=1;" parent="1" vertex="1"><mxGeometry x="650" y="460" width="300" height="130" as="geometry" /></mxCell><mxCell id="p2_stale_title" value="LEG 1 STALENESS TIMEOUT" style="text;html=1;fontSize=11;fontStyle=5;" parent="1" vertex="1"><mxGeometry x="670" y="465" width="220" height="20" as="geometry" /></mxCell><mxCell id="p2_stale" value="If Leg 1 Posted but unfilled&#10;for &gt; leg1_timeout_ms (1000ms):&#10;&#10;• Engine: check_leg1_staleness()&#10;• Send CancelLeg1 { order_id }&#10;• Reset leg1_state = None&#10;• Free slot for next spike" style="text;html=1;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="660" y="490" width="270" height="90" as="geometry" /></mxCell><mxCell id="p2_e1" parent="1" source="p2_posted" target="p2_sustain" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e2" value="Confirmed" style="fontColor=#28a745;fontSize=10;" parent="1" source="p2_sustain" target="p2_confirmed" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e3" value="Failed" style="fontColor=#b85450;fontSize=10;" parent="1" source="p2_sustain" target="p2_failed" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e4" parent="1" source="p2_failed" target="p2_failed_d" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e5" value="Posted" style="fontSize=9;" parent="1" source="p2_failed_d" target="p2_cancel" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e6" value="Filled" style="fontSize=9;" parent="1" source="p2_failed_d" target="p2_noop" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e7" parent="1" source="p2_confirmed" target="p2_sim_gate" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e8" parent="1" source="p2_confirmed" target="p2_live_post" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e9" parent="1" source="p2_sim_gate" target="p2_sim_fill" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e10" parent="1" source="p2_live_post" target="p2_live_fill" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e11" parent="1" source="p2_sim_fill" target="p2_erosion_init" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e12" parent="1" source="p2_live_fill" target="p2_erosion_init" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e13" parent="1" source="p2_erosion_init" target="p2_erosion_box" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e14" parent="1" source="p2_sim_l2" target="p2_complete" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e15" parent="1" source="p2_live_l2" target="p2_complete" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_whipsaw_note" value="WHIPSAW FOK BYPASS&#10;&#10;If whipsaw_fok_pending = true (opposite spike&#10;detected after Leg 1 fill), evaluate_leg2()&#10;calls emit_whipsaw_fok() → immediate FOK at&#10;best ask. Bypasses erosion entirely.&#10;ExitReason::WhipsawReversal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;dashed=1;" parent="1" vertex="1"><mxGeometry x="650" y="570" width="280" height="105" as="geometry" /></mxCell></root></mxGraphModel>
  </diagram>
  <diagram id="page3_emergency" name="3. Emergency Exits &amp; Cancellation">
    <mxGraphModel dx="1482" dy="823" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p3_title" value="Page 3: Emergency Exits &amp; Order Cancellation" style="text;html=1;fontSize=18;fontStyle=1;align=center;" parent="1" vertex="1"><mxGeometry x="400" y="10" width="450" height="30" as="geometry" /></mxCell><mxCell id="p3_em_title" value="EMERGENCY EXIT DECISION TREE (evaluate_leg2, gated by emergency_signal_in_flight flag)" style="text;html=1;fontSize=13;fontStyle=5;align=center;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" parent="1" vertex="1"><mxGeometry x="100" y="50" width="600" height="25" as="geometry" /></mxCell><mxCell id="p3_start" value="Leg 1 = Filled&#10;Erosion active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="320" y="90" width="160" height="40" as="geometry" /></mxCell><mxCell id="p3_d1" value="emergency_submitted&#10;= true?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="310" y="155" width="180" height="55" as="geometry" /></mxCell><mxCell id="p3_repost" value="Price-Improvement Chase&#10;post-only at best_ask - tick&#10;repost only on book improvement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1"><mxGeometry x="560" y="145" width="190" height="50" as="geometry" /></mxCell><mxCell id="p3_d_attempts" value="deadline expired?&#10;(2500ms)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="800" y="145" width="120" height="50" as="geometry" /></mxCell><mxCell id="p3_fok" value="FOK at round_to_tick(best_ask)&#10;(taker, crosses spread)&#10;zero-size guard + non-transient break" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="970" y="145" width="160" height="50" as="geometry" /></mxCell><mxCell id="p3_postonly" value="Post-only at&#10;best_ask - tick&#10;(maker, $0 fee)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=10;" parent="1" vertex="1"><mxGeometry x="810" y="220" width="120" height="45" as="geometry" /></mxCell><mxCell id="p3_d2" value="Adverse movement?&#10;Binance reversed&#10;&gt; 0.1% from fill" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="290" y="240" width="220" height="65" as="geometry" /></mxCell><mxCell id="p3_adverse" value="ADVERSE MOVEMENT&#10;exit_reason = AdverseMovement&#10;emergency_submitted = true&#10;Post-only at best_ask - tick&#10;Zero grace period" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1"><mxGeometry x="580" y="240" width="200" height="75" as="geometry" /></mxCell><mxCell id="p3_d3" value="Break-even breach?&#10;steps ≥ 1 AND&#10;leg1 + best_ask ≥ $1.00" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="290" y="440" width="220" height="65" as="geometry" /></mxCell><mxCell id="p3_be" value="BREAK-EVEN BREACH&#10;exit_reason = BreakEvenBreach&#10;emergency_submitted = true&#10;Post-only at best_ask - tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1"><mxGeometry x="580" y="445" width="200" height="60" as="geometry" /></mxCell><mxCell id="p3_d4" value="Erosion exhausted?&#10;steps_applied ≥ 5" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="305" y="540" width="190" height="55" as="geometry" /></mxCell><mxCell id="p3_exhaust" value="EROSION EXHAUSTED&#10;Auto-triggers as&#10;BreakEvenBreach emergency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1"><mxGeometry x="580" y="540" width="200" height="50" as="geometry" /></mxCell><mxCell id="p3_normal" value="No emergency → Normal erosion step&#10;(interval-gated, see Page 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1"><mxGeometry x="295" y="630" width="210" height="40" as="geometry" /></mxCell><mxCell id="p3_e1" parent="1" source="p3_start" target="p3_d1" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e1y" value="YES" style="fontColor=#b85450;fontSize=10;" parent="1" source="p3_d1" target="p3_repost" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e1n" value="NO" style="fontColor=#28a745;fontSize=10;" parent="1" source="p3_d1" target="p3_d2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e2y" value="YES" style="fontColor=#b85450;fontSize=10;" parent="1" source="p3_d2" target="p3_adverse" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e2n" value="NO" style="fontColor=#28a745;fontSize=10;" parent="1" source="p3_d2" target="p3_d_pre" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e3y" value="YES" style="fontColor=#b85450;fontSize=10;" parent="1" source="p3_d3" target="p3_be" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e3n" value="NO" style="fontColor=#28a745;fontSize=10;" parent="1" source="p3_d3" target="p3_d4" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e4y" value="YES" style="fontColor=#b85450;fontSize=10;" parent="1" source="p3_d4" target="p3_exhaust" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e4n" value="NO" style="fontColor=#28a745;fontSize=10;" parent="1" source="p3_d4" target="p3_normal" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_er1" parent="1" source="p3_repost" target="p3_d_attempts" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_er2" value="YES" style="fontColor=#b85450;fontSize=10;" parent="1" source="p3_d_attempts" target="p3_fok" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_er3" value="NO" style="fontColor=#28a745;fontSize=10;" parent="1" source="p3_d_attempts" target="p3_postonly" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_fav_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;dashed=1;" parent="1" vertex="1"><mxGeometry x="40" y="610" width="440" height="120" as="geometry" /></mxCell><mxCell id="p3_fav_title" value="FAVORABLE TAKER EXIT" style="text;html=1;fontSize=12;fontStyle=5;fillColor=#d4edda;strokeColor=#28a745;rounded=1;" parent="1" vertex="1"><mxGeometry x="55" y="615" width="190" height="22" as="geometry" /></mxCell><mxCell id="p3_fav_desc" value="Trigger: Opposing ask drops below posted Leg 2 bid&#10;(post-only would be rejected by CLOB — would cross spread)&#10;&#10;SIM: advance_sim detects ask &lt; posted → fill at ask (ExitReason::FavorableTaker)&#10;LIVE: CLOB rejects post-only → attempt_favorable_exit()&#10;       → $1 notional check first (skip if price*size &lt; $1)&#10;       → aggressive post-only at best_ask - tick → FOK fallback if rejected&#10;&#10;Taker fee acceptable vs risk of open position." style="text;html=1;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="50" y="640" width="420" height="80" as="geometry" /></mxCell><mxCell id="p3_rot_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" parent="1" vertex="1"><mxGeometry x="520" y="610" width="460" height="120" as="geometry" /></mxCell><mxCell id="p3_rot_title" value="ROTATION EMERGENCY (Market Expiry)" style="text;html=1;fontSize=12;fontStyle=5;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;" parent="1" vertex="1"><mxGeometry x="535" y="615" width="290" height="22" as="geometry" /></mxCell><mxCell id="p3_rot_desc" value="Trigger: MarketRotation arrives while Leg 1 = Filled, Leg 2 ≠ Filled&#10;&#10;1. Engine builds emergency FOK using OLD market's tokens/books&#10;   BEFORE state reset (exit_reason = MarketExpiry)&#10;2. Telegram fire_critical() alert for abandoned position&#10;3. Main loop drains rotation_emergency_buffer → executor&#10;4. Then sends MarketRotation → executor resets&#10;&#10;Best-effort: CLOB may reject if market already expired." style="text;html=1;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="530" y="640" width="440" height="85" as="geometry" /></mxCell><mxCell id="p3_cancel_title" value="ALL ORDER CANCELLATION TRIGGERS" style="text;html=1;fontSize=13;fontStyle=5;align=center;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" parent="1" vertex="1"><mxGeometry x="200" y="760" width="380" height="25" as="geometry" /></mxCell><mxCell id="p3_c1" value="1. SpikeFailed + leg1=Posted&#10;→ CancelLeg1 { order_id }&#10;→ Reset spike state&#10;→ leg1_state = None&#10;Cost: $0 (post-only never filled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="40" y="800" width="220" height="80" as="geometry" /></mxCell><mxCell id="p3_c2" value="2. Leg 1 Staleness Timeout&#10;→ Unfilled &gt; 1000ms&#10;→ CancelLeg1 { order_id }&#10;→ leg1_state = None&#10;→ Slot freed for next spike" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="290" y="800" width="210" height="80" as="geometry" /></mxCell><mxCell id="p3_c3" value="3. Erosion cancel-replace&#10;→ Each erosion step cancels&#10;  previous Leg 2 order&#10;→ Posts at new eroded price&#10;→ Normal lifecycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="530" y="800" width="200" height="80" as="geometry" /></mxCell><mxCell id="p3_c4" value="4. Emergency price-chase&#10;→ Post-only at best_ask - tick&#10;→ Repost only on book improvement&#10;→ FOK at deadline (2500ms)&#10;→ Preserves FIFO queue priority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="760" y="800" width="200" height="80" as="geometry" /></mxCell><mxCell id="p3_c5" value="5. Market Rotation&#10;→ cancel_all() on CLOB (live)&#10;→ Force-close open positions (sim)&#10;→ Reset all market state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="40" y="900" width="220" height="65" as="geometry" /></mxCell><mxCell id="p3_c6" value="6. CLOB Rejection (live only)&#10;→ Post-only rejected = price&#10;  would cross spread&#10;→ attempt_favorable_exit()&#10;→ Send OrderFailed feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="290" y="900" width="220" height="75" as="geometry" /></mxCell><mxCell id="p3_live_title2" value="LIVE EXECUTOR SIGNAL DISPATCH" style="text;html=1;fontSize=12;fontStyle=5;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;" parent="1" vertex="1"><mxGeometry x="600" y="900" width="280" height="22" as="geometry" /></mxCell><mxCell id="p3_live_dispatch" value="Signal dispatch in handle_signal():&#10;&#10;• is_leg2=false → handle_leg1()&#10;  Post-only GTC → OrderPosted/OrderFailed feedback&#10;&#10;• is_leg2=true, exit_reason=None → handle_leg2_erosion()&#10;  Cancel previous → repost at eroded price&#10;  If rejected → attempt_favorable_exit() ($1 notional gate)&#10;&#10;• is_leg2=true, exit_reason=Some → handle_leg2_emergency()&#10;  sim_was_taker=true → cancel + direct FOK (deadline)&#10;  sim_was_taker=false → cancel + post-only (price-chase)&#10;  If post-only rejected → FOK fallback&#10;&#10;Safety guards (all FOK paths):&#10;  • Zero-size abort (clob_safe_fok_size = 0)&#10;  • Non-transient error break (SDK validation)&#10;  • Filled FOK → active_order_id = None (anti-stack)" style="text;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#fff;strokeColor=#d79b00;rounded=1;" parent="1" vertex="1"><mxGeometry x="560" y="930" width="400" height="145" as="geometry" /></mxCell><mxCell id="p3_d_pre" value="Pre-erosion breach?&#10;steps == 0 AND&#10;leg1 + ask &gt; $1.02" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="290" y="340" width="220" height="65" as="geometry" /></mxCell><mxCell id="p3_pre" value="PRE-EROSION BREACH&#10;exit_reason = PreErosionBreach&#10;emergency_submitted = true&#10;Post-only at best_ask - tick&#10;Fast book repricing (&lt;4s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1"><mxGeometry x="580" y="340" width="200" height="75" as="geometry" /></mxCell><mxCell id="p3_epre_y" value="YES" style="fontColor=#b85450;fontSize=10;" parent="1" source="p3_d_pre" edge="1" target="p3_pre" /><mxCell id="p3_epre_n" value="NO" style="fontColor=#28a745;fontSize=10;" parent="1" source="p3_d_pre" edge="1" target="p3_d3" /><mxCell id="p3_whipsaw_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" parent="1" vertex="1"><mxGeometry x="40" y="470" width="230" height="120" as="geometry" /></mxCell><mxCell id="p3_whipsaw_title" value="WHIPSAW REVERSAL" style="text;html=1;fontSize=12;fontStyle=5;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" parent="1" vertex="1"><mxGeometry x="55" y="475" width="180" height="22" as="geometry" /></mxCell><mxCell id="p3_whipsaw_desc" value="Trigger: Opposite SpikeConfirmed while Leg 1 active&#10;&#10;Leg 1 Posted → Cancel immediately (like SpikeFailed)&#10;Leg 1 Filled → whipsaw_fok_pending = true&#10;  → evaluate_leg2() emits immediate FOK at best_ask&#10;  → Bypasses erosion entirely (no post-only chase)&#10;&#10;exit_reason = WhipsawReversal" style="text;html=1;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="50" y="498" width="215" height="87" as="geometry" /></mxCell><mxCell id="p3_c7" value="7. Whipsaw cancel (Leg 1)&#10;→ Opposite SpikeConfirmed&#10;  while leg1_state = Posted&#10;→ CancelLeg1 { order_id }&#10;→ Reset Leg 1 + spike state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="540" y="900" width="200" height="75" as="geometry" /></mxCell></root></mxGraphModel>
  </diagram>
  <diagram id="page4_engine" name="4. Engine Loop &amp; Edge Cases">
    <mxGraphModel dx="1482" dy="823" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p4_title" value="Page 4: Engine Loop Order, State Machines &amp; Edge Cases" style="text;html=1;fontSize=18;fontStyle=1;align=center;" parent="1" vertex="1"><mxGeometry x="350" y="10" width="500" height="30" as="geometry" /></mxCell><mxCell id="p4_loop_title" value="ENGINE LOOP (main.rs) — exact order per event" style="text;html=1;fontSize=13;fontStyle=5;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="50" width="380" height="25" as="geometry" /></mxCell><mxCell id="p4_l1" value="1. Drain feedback_rx (LIVE)&#10;   OrderPosted → store order_id&#10;   OrderFailed → reset leg state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="85" width="230" height="48" as="geometry" /></mxCell><mxCell id="p4_l2" value="2. on_event(event)&#10;   Update MarketState&#10;   Handle SpikeCandidate/Confirmed/Failed&#10;   Quiet period + cutoff window detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="145" width="250" height="48" as="geometry" /></mxCell><mxCell id="p4_l3" value="3. Record book snapshots (every 5s, QuestDB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="205" width="290" height="28" as="geometry" /></mxCell><mxCell id="p4_l4" value="4. Drain rotation emergencies&#10;   FOK hedge for open Leg 1 before state reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="245" width="290" height="38" as="geometry" /></mxCell><mxCell id="p4_l5" value="5. Send MarketRotation (after emergencies)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="295" width="290" height="28" as="geometry" /></mxCell><mxCell id="p4_l6" value="6. Send MarketCutoff (once, 180s before expiry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="335" width="290" height="28" as="geometry" /></mxCell><mxCell id="p4_l7" value="7. advance_simulation() (SIM ONLY)&#10;   Fill state machine: Leg 1 + Leg 2&#10;   BLOCKED if speculative_awaiting_sustain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="375" width="270" height="48" as="geometry" /></mxCell><mxCell id="p4_l8" value="8. take_spike_cancel()&#10;   Drain CancelLeg1 from SpikeFailed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="435" width="250" height="38" as="geometry" /></mxCell><mxCell id="p4_l9" value="9. check_leg1_staleness()&#10;   Cancel if Posted &gt; 1000ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="485" width="230" height="38" as="geometry" /></mxCell><mxCell id="p4_l10" value="10. evaluate() → Leg 1 signal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="535" width="230" height="28" as="geometry" /></mxCell><mxCell id="p4_l11" value="11. evaluate_leg2() → Leg 2 signal&#10;    GATED: emergency_signal_in_flight blocks&#10;    GATED: leg2_command_pending blocks&#10;    WHIPSAW: whipsaw_fok_pending → immediate FOK&#10;    SIM: only erosion (no emergencies)&#10;    LIVE: all signals (erosion + emergency)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="575" width="280" height="48" as="geometry" /></mxCell><mxCell id="p4_l12" value="12. Trade completion (LIVE ONLY)&#10;    Both legs Filled → on_trade_complete()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="635" width="260" height="38" as="geometry" /></mxCell><mxCell id="p4_l13" value="13. check_diagnostic() (60s counters)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="685" width="250" height="28" as="geometry" /></mxCell><mxCell id="p4_le1" parent="1" source="p4_l1" target="p4_l2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_le2" parent="1" source="p4_l2" target="p4_l3" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_le3" parent="1" source="p4_l3" target="p4_l4" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_le4" parent="1" source="p4_l4" target="p4_l5" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_le5" parent="1" source="p4_l5" target="p4_l6" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_le6" parent="1" source="p4_l6" target="p4_l7" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_le7" parent="1" source="p4_l7" target="p4_l8" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_le8" parent="1" source="p4_l8" target="p4_l9" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_le9" parent="1" source="p4_l9" target="p4_l10" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_le10" parent="1" source="p4_l10" target="p4_l11" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_le11" parent="1" source="p4_l11" target="p4_l12" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_le12" parent="1" source="p4_l12" target="p4_l13" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_order_note" value="CRITICAL ORDERING:&#10;• Feedback drained BEFORE on_event&#10;  (CLOB RTT ~50ms &lt; User WS ~200ms)&#10;• Rotation emergencies BEFORE rotation&#10;  (hedge old position before reset)&#10;• advance_simulation BEFORE evaluate&#10;  (process fills before new signals)&#10;• SIM: emergencies NOT sent to executor&#10;  (handled by advance_simulation)&#10;• LIVE: ALL signals sent to executor" style="text;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" parent="1" vertex="1"><mxGeometry x="50" y="730" width="280" height="140" as="geometry" /></mxCell><mxCell id="p4_sm_title" value="STATE MACHINES" style="text;html=1;fontSize=13;fontStyle=5;align=center;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" parent="1" vertex="1"><mxGeometry x="520" y="50" width="180" height="25" as="geometry" /></mxCell><mxCell id="p4_os_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;dashed=1;" parent="1" vertex="1"><mxGeometry x="420" y="85" width="560" height="200" as="geometry" /></mxCell><mxCell id="p4_os_title" value="OrderState (per leg)" style="text;html=1;fontSize=11;fontStyle=5;" parent="1" vertex="1"><mxGeometry x="440" y="90" width="150" height="20" as="geometry" /></mxCell><mxCell id="p4_os_none" value="None" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="440" y="160" width="80" height="40" as="geometry" /></mxCell><mxCell id="p4_os_posted" value="Posted" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="620" y="120" width="90" height="40" as="geometry" /></mxCell><mxCell id="p4_os_filled" value="Filled" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="820" y="160" width="90" height="40" as="geometry" /></mxCell><mxCell id="p4_os_e1" value="evaluate()&#10;(SpikeCandidate)" style="fontSize=9;" parent="1" source="p4_os_none" target="p4_os_posted" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_os_e2" value="User WS /&#10;advance_sim" style="fontSize=9;" parent="1" source="p4_os_posted" target="p4_os_filled" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_os_e3" value="SpikeFailed /&#10;Staleness /&#10;CLOB reject" style="fontSize=9;fontColor=#b85450;" parent="1" source="p4_os_posted" target="p4_os_none" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="230" /><mxPoint x="520" y="230" /></Array></mxGeometry></mxCell><mxCell id="p4_os_e4" value="on_trade_complete /&#10;MarketRotation" style="fontSize=9;fontColor=#b85450;" parent="1" source="p4_os_filled" target="p4_os_none" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="260" /><mxPoint x="480" y="260" /></Array></mxGeometry></mxCell><mxCell id="p4_er_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;dashed=1;" parent="1" vertex="1"><mxGeometry x="420" y="310" width="560" height="180" as="geometry" /></mxCell><mxCell id="p4_er_title" value="ErosionState" style="text;html=1;fontSize=11;fontStyle=5;" parent="1" vertex="1"><mxGeometry x="440" y="315" width="100" height="20" as="geometry" /></mxCell><mxCell id="p4_er_none" value="None" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333;fontStyle=1;fontSize=11;" parent="1" vertex="1"><mxGeometry x="440" y="370" width="70" height="35" as="geometry" /></mxCell><mxCell id="p4_er_active" value="Active&#10;steps=0..4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;" parent="1" vertex="1"><mxGeometry x="600" y="345" width="90" height="45" as="geometry" /></mxCell><mxCell id="p4_er_emergency" value="Emergency&#10;post-only→FOK" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;" parent="1" vertex="1"><mxGeometry x="780" y="345" width="110" height="45" as="geometry" /></mxCell><mxCell id="p4_er_done" value="Fill →&#10;None" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontStyle=1;fontSize=10;" parent="1" vertex="1"><mxGeometry x="780" y="420" width="80" height="40" as="geometry" /></mxCell><mxCell id="p4_er_e1" value="init_erosion()" style="fontSize=9;" parent="1" source="p4_er_none" target="p4_er_active" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_er_e2" value="adverse /&#10;pre-erosion /&#10;break-even /&#10;exhausted /&#10;whipsaw" style="fontSize=9;fontColor=#b85450;" parent="1" source="p4_er_active" target="p4_er_emergency" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_er_e3" value="fill" style="fontSize=9;" parent="1" source="p4_er_active" target="p4_er_done" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="645" y="440" /></Array></mxGeometry></mxCell><mxCell id="p4_er_e4" value="fill / FOK" style="fontSize=9;" parent="1" source="p4_er_emergency" target="p4_er_done" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_edge_title" value="EDGE CASES &amp; RACE CONDITIONS" style="text;html=1;fontSize=13;fontStyle=5;align=center;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" parent="1" vertex="1"><mxGeometry x="420" y="510" width="320" height="25" as="geometry" /></mxCell><mxCell id="p4_ec1" value="SpikeFailed races with fill (LIVE)&#10;&#10;CLOB fills speculative Leg 1 before SpikeFailed arrives.&#10;SpikeFailed checks leg1_state: if Filled → no-op, Leg 2 proceeds.&#10;The fill is valid (ATR+magnitude signal was genuine).&#10;Same race semantics as Leg 1 staleness timeout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="420" y="545" width="370" height="85" as="geometry" /></mxCell><mxCell id="p4_ec2" value="New spike during speculative window&#10;&#10;A second spike arrives while first is Posted (awaiting sustain).&#10;ActiveTrade guard rejects it (leg1_state == Posted).&#10;After SpikeFailed cancels → leg1_state = None → next spike accepted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="420" y="645" width="370" height="75" as="geometry" /></mxCell><mxCell id="p4_ec3" value="Rotation while Leg 2 posting&#10;&#10;MarketRotation arrives, Leg 1 Filled, Leg 2 incomplete.&#10;Engine builds emergency FOK from OLD market state BEFORE reset.&#10;Telegram fire_critical() alerts for abandoned position.&#10;Main loop sends emergency BEFORE MarketRotation to executor.&#10;Guarantees hedge attempt before state wipe." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="420" y="735" width="370" height="80" as="geometry" /></mxCell><mxCell id="p4_ec4" value="User WS fill delay (LIVE)&#10;&#10;CLOB fills order, but User WS notification arrives 200-500ms later.&#10;Feedback channel sends real order_id back in ~50ms (REST RTT).&#10;Engine stores order_id immediately via feedback drain (step 1).&#10;When User WS notification arrives, engine matches by order_id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="420" y="830" width="370" height="80" as="geometry" /></mxCell><mxCell id="p4_ec5" value="Cutoff window behavior&#10;&#10;Last 180s before market expiry: no new Leg 1 entries.&#10;Existing Leg 2 erosion + emergency exits continue unimpeded.&#10;MarketCutoff triggers Telegram summary (sim only)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="810" y="545" width="320" height="75" as="geometry" /></mxCell><mxCell id="p4_ec6" value="Double emergency prevention&#10;&#10;Once emergency_submitted = true, evaluator switches to&#10;price-improvement chase (not re-triggering). exit_reason&#10;preserved. Only reposts on book improvement, FOK at deadline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="810" y="635" width="320" height="75" as="geometry" /></mxCell><mxCell id="p4_ec7" value="Zero ask depth in emergency&#10;&#10;If hedge book has no ask depth within 2 ticks, FOK size&#10;caps to zero. Evaluator returns None, will re-evaluate&#10;on next event when depth may have recovered." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="810" y="725" width="320" height="70" as="geometry" /></mxCell><mxCell id="p4_ec8" value="Spike during existing trade&#10;&#10;ActiveTrade guard rejects spike after checking spread.&#10;rej_busy counter tracks valid-book spikes lost to busy executor.&#10;spike_detected cleared — spike consumed, cannot re-evaluate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="810" y="810" width="320" height="70" as="geometry" /></mxCell><mxCell id="p4_ec9" value="Emergency signal stacking (LIVE)&#10;&#10;Engine evaluates every ~2-50ms, executor takes ~1-2s per CLOB call.&#10;emergency_signal_in_flight flag gates evaluate_leg2() while set.&#10;Set on emergency dispatch, cleared on OrderPosted/OrderFailed/&#10;CancelResult feedback. Filled FOKs set active_order_id=None&#10;to prevent stale cancel of completed orders." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="420" y="920" width="370" height="90" as="geometry" /></mxCell><mxCell id="p4_ec_quiet" value="Rotation quiet period&#10;&#10;After MarketRotation, in_quiet_period = true for&#10;rotation_quiet_ms (30s). All SpikeCandidate events&#10;are dropped during this window. Prevents entries on&#10;stale/repricing books after rotation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="810" y="895" width="320" height="80" as="geometry" /></mxCell><mxCell id="p4_ec_whipsaw" value="Whipsaw spike guard&#10;&#10;Opposite SpikeConfirmed while Leg 1 active:&#10;• Leg 1 Posted → cancel (like SpikeFailed)&#10;• Leg 1 Filled → whipsaw_fok_pending = true&#10;  → immediate FOK at best ask, bypasses erosion&#10;Provisional ID deferral applies (cancel_leg1_on_feedback)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="420" y="1020" width="370" height="90" as="geometry" /></mxCell><mxCell id="p4_ec_pre_erosion" value="Pre-erosion breach&#10;&#10;When steps_applied == 0 and leg1_price + best_ask &gt;&#10;pre_erosion_breach_threshold ($1.02), emergency fires&#10;BEFORE first erosion step. Catches fast book repricing&#10;within ~4s that break-even check misses (needs steps ≥ 1)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="810" y="990" width="320" height="80" as="geometry" /></mxCell><mxCell id="p4_ec_direction" value="init_erosion() direction safety&#10;&#10;Uses leg1_direction (set at Leg 1 signal generation)&#10;instead of spike.direction. Survives spike overwrites&#10;between Leg 1 fill and erosion init. Prevents YES/NO&#10;label swap in trade completion messages." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="420" y="1120" width="370" height="75" as="geometry" /></mxCell></root></mxGraphModel>
  </diagram>
